/* settings.uss: pantalla Settings.
   Las filas se construyen desde datos; su aspecto vive acá.
   Los tamaños son ~1,5× los del diseño original: 16 px de texto allá ≈ 24 px acá. */

/* Contenedor de pestañas. Todavía vacío: el selector no está hecho. */
.settings-tabs {
    flex-direction: row;
    justify-content: center;
    margin-top: 16px;
}

/* La lista: 960 px de ancho y 46 % de la pantalla como alto máximo.
   Sin verificar: si dentro de una pantalla centrada colapsa a 0, cambiar max-height por height. */
.settings-rows {
    width: 960px;
    max-width: 88%;
    max-height: 46%;
    margin-top: 24px;
}

/* Una fila: etiqueta a la izquierda, control a la derecha, línea tenue abajo. */
.settings-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(232, 217, 220, 0.13);   /* #e8d9dc22 */
}

.settings-row__label {
    flex-shrink: 1;
    font-size: 24px;
    color: var(--color-fg);
    white-space: normal;
}

.settings-row__control {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 48px;
}

/* Línea reservada para describir la opción enfocada. Vacía todavía, pero ya ocupa su lugar:
   así el layout no salta cuando aparece el texto. */
.settings-desc {
    min-height: 30px;
    max-width: 900px;
    margin-top: 16px;
    font-size: 20px;
    color: var(--color-fg);
    opacity: 0.7;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ── Slider ── Restilado modesto a propósito: los nombres de las partes internas son de Unity,
   conviene confirmarlos con el UI Toolkit Debugger antes de depender de ellos. */

.settings-slider {
    width: 320px;
    margin: 0;
}

.settings-slider .unity-base-slider__tracker {
    background-color: rgba(232, 217, 220, 0.25);
    border-width: 0;
}

.settings-slider .unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-width: 0;
}

/* El número, de solo lectura. Ancho fijo para que el slider no se mueva cuando el valor
   pasa de 9 a 10 o de 99 a 100. */
.settings-slider__value {
    width: 72px;
    margin-left: 16px;
    font-size: 22px;
    color: var(--color-fg);
    -unity-text-align: middle-right;
}
