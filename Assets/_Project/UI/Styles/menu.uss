.root {
    flex-grow: 1;}

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Lacquer/Lacquer-Regular.ttf?fileID=12800000&guid=150021e55bb757e449b1a6db9363764e&type=3#Lacquer-Regular");

}

.logo {
    width: 370px;
    height: 330px;
    max-width: 75%;
    max-height: 36%;
    flex-shrink: 0;
    margin-bottom: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.menu-list {
    width: 100%;
    flex-shrink: 0;
    align-items: center;
}

.menu-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0 0 var(--gap-menu) 0;
    padding: 0;
    color: var(--color-fg);
    font-size: var(--size-button);
    letter-spacing: 2px;
    transition-property: color, scale;
    transition-duration: var(--time-hover);
}

.menu-btn--a {
    rotate: -1.5deg;
}

.menu-btn--b {
    rotate: 1deg;
}

.menu-btn:hover,
.menu-btn:focus {
    color: var(--color-hover);
    scale: 1.07 1.07;
}

.font-body {
    -unity-font-definition: url("project://database/Assets/_Project/Art/Fonts/Lacquer/Lacquer-Regular.ttf?fileID=12800000&guid=150021e55bb757e449b1a6db9363764e&type=3#Lacquer-Regular");
}

.panel-title {
    font-size: 62px;
    letter-spacing: 5px;
    color: var(--color-accent);
    text-shadow: 3px 3px 0 var(--color-blue);
    -unity-text-align: middle-center;
}

.back-btn {
    position: absolute;
    left: 60px;
    bottom: 45px;
    margin: 0;
    padding: 6px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    font-size: 26px;
    letter-spacing: 4px;
    color: var(--color-fg);
    opacity: 0.7;
    transition-property: color, scale, opacity;
    transition-duration: var(--time-hover);
}

.back-btn:hover,
.back-btn:focus {
    color: var(--color-hover);
    opacity: 1;
    scale: 1.07 1.07;
}
