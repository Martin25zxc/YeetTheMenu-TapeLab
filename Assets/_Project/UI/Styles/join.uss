/* join.uss: pantallas Join y Joining (laboratorio). */
/* El TextField es un contenedor: lo que se ve es su elemento interno.
   El tema por defecto le pone fondo, borde y esquinas: acá se quitan. */
.code-field .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-fg);
    border-radius: 0;
    padding: 14px;
    font-size: 38px;
    letter-spacing: 15px;
    color: var(--color-fg);
    -unity-text-align: middle-center;
}

/* El foco de un campo de texto se ve SIEMPRE, también con mouse:
   es donde se escribe (igual que :focus-visible con un input web). */
.code-field:focus .unity-base-text-field__input {
    border-bottom-color: var(--color-accent);
}

.code-error {
    min-height: 34px;   /* reserva el espacio: el layout no salta cuando aparece el error */
    max-width: 900px;
    margin-top: 12px;
    font-size: 22px;
    color: var(--color-warn);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Sin error, la misma línea muestra la ayuda, tenue.
   Va después de .code-error en el mismo archivo: igual especificidad, gana por orden. */
.code-error--hint {
    color: var(--color-fg);
    opacity: 0.55;
}

/* Mide lo mismo que el campo (PASTE es absoluto y no cuenta): el campo queda centrado. */
.code-row {
    margin-top: 34px;
}

.code-field {
    width: 480px;
    margin: 0;
    --unity-cursor-color: var(--color-accent);
}

/* Ayuda del campo: chica, con borde, claramente subordinada a CONFIRM. */
.paste-btn {
    position: absolute;
    left: 100%;          /* arranca en el borde derecho del campo */
    bottom: 6px;         /* alineado con la línea inferior del campo */
    margin: 0 0 0 24px;  /* separación del campo */
    padding: 6px 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: var(--color-fg);
    border-radius: 0;
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--color-fg);
    opacity: 0.7;
    transition-property: color, border-color, opacity;
    transition-duration: var(--time-hover);
}

.paste-btn:hover {
    color: var(--color-hover);
    border-color: var(--color-hover);
    opacity: 1;
}

/* Modo teclado/mando: el hover se ignora y manda el foco, como en el resto del menú. */
.input-directional .paste-btn:hover {
    color: var(--color-fg);
    border-color: var(--color-fg);
    opacity: 0.7;
}

.input-directional .paste-btn:focus {
    color: var(--color-hover);
    border-color: var(--color-hover);
    opacity: 1;
}